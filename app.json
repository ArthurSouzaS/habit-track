{
  "expo": {
    "name": "Habit Track",
    "slug": "habit-track",
    "version": "1.0.0",
    "description": "App de hábitos e metas com sequências, calendário heatmap, estatísticas e lembretes.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "habittrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arthursouzas.habittrack"
    },
    "android": {
      "package": "com.arthursouzas.habittrack",
      "adaptiveIcon": {
        "backgroundColor": "#6C5CE7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "Habit Track",
      "shortName": "Habit Track",
      "lang": "pt-BR",
      "themeColor": "#6C5CE7",
      "backgroundColor": "#F5F6FB",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6C5CE7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#6C5CE7"
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/habit-track",
      "reactCompiler": true
    }
  }
}
